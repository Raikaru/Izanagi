# The battle simulator: one Zig object per module (055-zig.cmake), each keeping its module's C ABI exports. They are p4port sources,
# so $<TARGET_OBJECTS:p4port> carries them to the tables, the CRT audits and every link, and p4port64/p4port64w compile them again.
set(P4_BATTLE_SIM_ZIG
  src/platform/battle_sim/session.zig src/platform/battle_sim/entry.zig src/platform/battle_sim/graphics.zig
  src/platform/battle_sim/result_prompt.zig
  src/platform/battle_sim/events.zig src/platform/battle_sim/events_native.zig
  src/platform/battle_sim/policy.zig src/platform/battle_sim/expert.zig src/platform/battle_sim/strategy.zig
  src/platform/battle_sim/prepare.zig src/platform/battle_sim/prepare_native.zig
  src/platform/battle_sim/live.zig src/platform/battle_sim/live_entry.zig)
# The translated bindings reach platform headers by their src/platform path (pad/pad_sdl.h, memcard/mod_save_transport.h): Zig sources only, so
# the C units' include search is unchanged.
set_source_files_properties(${P4_BATTLE_SIM_ZIG} PROPERTIES INCLUDE_DIRECTORIES "${CMAKE_SOURCE_DIR}/src/platform")
target_sources(p4port PRIVATE ${P4_BATTLE_SIM_ZIG})
target_sources(p4port PRIVATE src/platform/battle_sim/observation.c)

# The public C declarations of every module's exports, in one header: the 64-bit ABI table (340-port64-abi.cmake) takes the register
# ABI of a Zig export from its prototype here (a Zig source has no C definition to read). Written only when its text changes.
set(P4_BATTLE_SIM_ABI_HEADER "${P4_GEN}/battle_sim_exports.h")
file(CONFIGURE OUTPUT "${P4_BATTLE_SIM_ABI_HEADER}" CONTENT [[
/* Generated by cmake/sources/187-battle-sim.cmake: the C ABI of the battle simulator's Zig exports. */
#include "p4pc/battle_sim.h"
#include "p4pc/battle_events.h"
#include "p4pc/battle_events_native.h"
#include "p4pc/battle_strategy.h"
#include "p4pc/battle_prepare.h"
int p4_battle_sim_is_boss(void);
int p4_battle_sim_opening_active(void);
void *p4_battle_sim_decision_trace(void);
struct bsim_observation;
struct bsim_choice;
int bsim_choose(const struct bsim_observation *, int, struct bsim_choice *);
#include "p4pc/battle_live.h"
]] @ONLY)
