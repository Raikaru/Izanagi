set(CMAKE_Zig_COMPILER "@CMAKE_Zig_COMPILER@")
set(CMAKE_Zig_COMPILER_ID "@CMAKE_Zig_COMPILER_ID@")
set(CMAKE_Zig_COMPILER_VERSION "@CMAKE_Zig_COMPILER_VERSION@")
set(CMAKE_Zig_COMPILER_LOADED 1)
set(CMAKE_Zig_COMPILER_ENV_VAR "P4_ZIG")
set(CMAKE_Zig_SOURCE_FILE_EXTENSIONS zig)
set(CMAKE_Zig_IGNORE_EXTENSIONS)
# C links every target: a Zig object never selects the linker.
set(CMAKE_Zig_LINKER_PREFERENCE 0)
set(CMAKE_Zig_LINKER_PREFERENCE_PROPAGATES 0)
