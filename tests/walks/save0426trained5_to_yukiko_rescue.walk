# Per-character first plans align each remembered wheel; subsequent turns repeat the selected action.
battle:first1=up,cross,cross,cross;first3=up,cross;plan=cross,cross,cross
battleskip:on
wait:1000
# Keep the in-flight first plan through native TARGET6 and select the Prince.
battle:first1=circle,circle,circle,down,cross,cross,right,cross;plan=cross,cross,cross
wait:700
# Chie's native target initialization already selects the Prince here; Right rotated her back to Yukiko.
battle:first3=down,down,cross,down,down,cross,cross;plan=cross,cross,cross
wait:6000
# Return Chie to Guard before damaging Yukiko into the Burn to Ashes phase.
battle:first3=circle,circle,circle,up,cross;plan=cross,cross,cross
wait:10000
# A physical finisher avoids confirming a disabled Bufu after Yu runs out of SP.
battle:first1=circle,circle,circle,cross,cross;plan=cross,cross,cross
wait:8000
