if(P4PC_LUAU)
  foreach(pair "p4_x64|64" "p4_x64w|64w")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 cohort)
    list(GET parts 1 suffix)
    if(TARGET ${cohort} AND TARGET p4_luau${suffix})
      add_dependencies(${cohort} p4_luau_check${suffix} p4mod${suffix} p4mod_game_fixture${suffix} p4mod_zip32_test${suffix} luau_sandbox_test${suffix}
        fusion_arts_safety_test${suffix})
    endif()
    if(TARGET ${cohort} AND TARGET luau_script_runner${suffix})
      add_dependencies(${cohort} luau_script_runner${suffix})
    endif()
    if(TARGET ${cohort} AND TARGET mod_luau_test${suffix})
      add_dependencies(${cohort} mod_luau_test${suffix})
    endif()
    if(TARGET ${cohort} AND TARGET mod_luau_save_test${suffix})
      add_dependencies(${cohort} mod_luau_save_test${suffix})
    endif()
    if(TARGET ${cohort} AND TARGET lua_semantic_subscription_test${suffix})
      add_dependencies(${cohort} lua_semantic_subscription_test${suffix})
    endif()
    if(TARGET ${cohort} AND TARGET mod_scene_status_test${suffix})
      add_dependencies(${cohort} mod_scene_status_test${suffix})
    endif()
    if(TARGET ${cohort} AND TARGET mod_calendar_hold_test${suffix})
      add_dependencies(${cohort} mod_calendar_hold_test${suffix})
    endif()
    if(TARGET ${cohort} AND TARGET mod_luau_status_test${suffix})
      add_dependencies(${cohort} mod_luau_status_test${suffix})
    endif()
  endforeach()
endif()
