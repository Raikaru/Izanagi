# The GameFAQs 18664 save (04/11, Dojima living room) loaded through the title (P4PC_AUTOPRESS_LOAD=0, frame 0 = the load confirm): the slot browser,
# Yes, "Load successful", then the stairs -> Your Room -> futon -> the fog dream.
timeout:6000
wait:140
press:cross               # the slot
wait:140
press:cross               # Yes
wait:140
press:cross               # Load successful
skipmsg                   # the load's Help window, until the player is free
wait:30
walk:314,-360,25          # the foot of the stairs (the CHECK icon)
wait:20
press:cross               # go upstairs
wait:40
skipmsg                   # "This is the room you're borrowing from Dojima..."
wait:30
press:down:200            # to the wall by the futon (Your Room: x -16..240, z -184..133)
wait:30
press:cross               # CHECK the futon: "The futon has been prepared", Help, "Go to sleep?" (Yes is the default)
wait:40
skipmsg                   # Cross through the prompts, the sleep, up to the first control in the dream
