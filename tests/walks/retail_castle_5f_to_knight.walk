walk:8800,15450,100
push:9300,15450,40       # the corridor's east end, area 3400 (warp_006f_01): back to (3603,11297)
wait:400
waitcontrol:on
wait:60
log
walk:3600,10600,100
push:3600,10000,40   # area 3403 (warp_006f_04) -> (7902,5995)
wait:400
waitcontrol:on
wait:60
