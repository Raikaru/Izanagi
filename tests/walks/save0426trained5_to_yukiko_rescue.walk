# Rules from here: Yu (Senri, Fire Null) casts Bufu, Media for anyone under 90 HP, and falls back to his weapon without SP;
# Chie (Direct Commands) casts Bufu, falls back to her weapon, and Guards while Shadow Yukiko (258) is charged for
# Burn to Ashes; Yosuke stays Heal/Support. Both strike Yukiko until she summons the Ice-weak, healing Charming Prince
# (269) on her second turn, then the Prince until it falls, then Yukiko again.
battle:first1=circle,down,cross,skill:26,cross,cross,circle,circle,circle,cross,cross;plan1=circle,down,cross,skill:26,cross,cross,circle,circle,circle,cross,cross;plan=circle,down,cross,skill:26,cross,cross,circle,circle,circle,cross,cross;skip=0;delay=80;target1=258;target3=258;guard=258:3
battlerule:hp<90@1=circle,down,cross,skill:195,cross,cross,circle,circle,circle,cross,cross
battleskip:on
timeout:40000
waitbtl:menu:3
waitbtl:menu:1
log
battle:first1=circle,down,cross,skill:26,cross,cross,circle,circle,circle,cross,cross;plan1=circle,down,cross,skill:26,cross,cross,circle,circle,circle,cross,cross;plan=circle,down,cross,skill:26,cross,cross,circle,circle,circle,cross,cross;skip=0;delay=80;target1=269;target3=269;guard=258:3
battlerule:hp<90@1=circle,down,cross,skill:195,cross,cross,circle,circle,circle,cross,cross
waitbtl:dead:269
log
# Yukiko is then the only target, so no binding is needed (an ally-target Soul Drop could not satisfy one):
# Yu opens with Rakunda and drinks a Soul Drop below 8 SP.
battle:first1=circle,down,cross,skill:215,cross,cross,circle,circle,circle,cross,cross;plan1=circle,down,cross,skill:26,cross,cross,circle,circle,circle,cross,cross;plan=circle,down,cross,skill:26,cross,cross,circle,circle,circle,cross,cross;skip=0;delay=80;guard=258:3
battlerule:sp<8@1=circle,down,down,down,cross,item:0x30B,cross,cross,circle,circle,circle,cross,cross
battlerule:hp<90@1=circle,down,cross,skill:195,cross,cross,circle,circle,circle,cross,cross
log
waittask:battle:off
