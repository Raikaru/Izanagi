# New Game events (AUTOPRESS cross/start) until the first control in the Dojima living room
timeout:40000
skipmsg                   # the opening events, then the Help window: Cross until the player is free
# Dojima living room (04/11 evening) -> stairs -> Your Room -> futon -> "Go to sleep? Yes" -> the fog dream, controllable.
# Retail: p4hook --walk FILE (from the state ng-livingroom). Port: P4PC_WALK_SCRIPT=FILE after the New Game events.
# Coordinates are world units read from the player's matrix (task `rotate pc`, work + 0x48): living room x -313..459, z -270..222.
waitcontrol:on
wait:30
walk:314,-360,25          # the foot of the stairs (the CHECK icon)
wait:20
press:cross               # go upstairs
wait:40
skipmsg                   # "This is the room you're borrowing from Dojima..."
wait:30
press:down:200            # to the wall by the futon (Your Room: x -16..240, z -184..133)
wait:30
press:cross               # CHECK the futon: "The futon has been prepared", Help, "Go to sleep?" (Yes is the default)
wait:40
skipmsg                   # Cross through the prompts, the sleep, up to the first control in the dream
# The fog dream: the corridor to its door, the door (per4DungeonDoor, x 8400, z 1800, Cross within 250 units), the tutorial battle,
# the wake-up on 04/12, breakfast, the walk to school and the school day: Cross through every message and event until the player is free.
waitcontrol:on
walk:8160,1989,60         # the corridor runs along -Z from z 24000; messages on the way are skipped (autoskip)
walk:8400,1989,40         # the end of the corridor
wait:20
press:cross               # the door
wait:60
timeout:60000
skipmsg
# 04/12 evening: the same living room, stairs and futon
waitcontrol:on
wait:30
walk:314,-360,25          # the foot of the stairs (the CHECK icon)
wait:20
press:cross               # go upstairs
wait:40
skipmsg                   # "This is the room you're borrowing from Dojima..."
wait:30
press:down:200            # to the wall by the futon (Your Room: x -16..240, z -184..133)
wait:30
press:cross               # CHECK the futon: "The futon has been prepared", Help, "Go to sleep?" (Yes is the default)
wait:40
skipmsg                   # Cross through the prompts, the sleep, up to the first control in the dream
