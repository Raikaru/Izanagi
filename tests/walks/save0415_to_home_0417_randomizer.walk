# save0415_to_home_0417.walk for the randomized 04/15 evening save of tests/mod_randomizer_dungeon_test.py (loaded through the
# title with P4PC_AUTOPRESS_LOAD=0) through Castle 2F's Shadow Chie fight to home on 04/17 evening. Only the battle plans differ:
# the run's floor Shadows (other groups of the same size, within three levels, stats scaled to the floor) hit harder than the
# stock ones, so the party plays as a player would: Attack on the floor, a Revival Bead for a downed ally and Medicine under
# 30 HP, and in the boss fight explicit Cleave/Garu commands (the floor fights leave the wheels on Attack) with the same heals
# and Attack once Yosuke's SP runs out.
# Plays 04/15 night, 04/16's events, 04/17's police/Daidara visit and the mandatory castle fights.
timeout:6000
wait:140
press:cross               # the slot
wait:140
press:cross               # Yes
wait:140
press:cross               # Load successful
skipmsg                   # the load's Help window, until the player is free
timeout:40000
# 04/15 night: stairs, futon
waitcontrol:on
wait:30
walk:314,-360,25          # the foot of the stairs (the CHECK icon)
face:100                  # toward the trigger (area x 227..584 z -476..-282): Cross needs it within the cone
wait:20
press:cross               # go upstairs
wait:40
skipmsg
wait:30
press:down:200            # to the wall by the futon
wait:30
press:cross               # CHECK the futon, "Go to sleep?" Yes
wait:40
skipmsg                   # the night, 04/16 (school, Junes, the rain) up to the evening in the living room
# 04/16 evening: the front door (area 3400, `door_entrance`) is still shut; upstairs, and the story takes the player on
waitcontrol:on
wait:30
walk:314,-360,25
face:100
wait:20
press:cross
wait:40
skipfield:8:4             # the Midnight Channel, 04/17, the police station, then Daidara (field 8 room 4)
# Advance the talk only until the shop task appears, not for a fixed load-dependent duration.
skiptask:Y_FclShopMainProc
wait:90
press:circle:10
wait:90
press:circle:10
wait:90
press:circle:10
wait:90
press:circle:10
wait:90
waittask:Y_FclShopMainProc:off
skipmsg                   # the rest of the scene, until the player is free in the shopping district
# The street's east end: the bus stop (area 3406, `basutei`), then east past it onto the exit (area 3400, `call_lmap`: Cross opens the map and picks Junes)
timeout:20000
walk:661,250,40
push:1000,150,60
wait:10
press:cross
skipfield:9:1             # Junes (field 9 room 1)
# Junes: Yosuke, Chie and Teddie at the TV (f009_001, f020_001), through it into Yukiko's Castle (field 23): the gate, free control
skipmsg

# Into the castle (the gate's door area, then field 40 room 0 = 1F, a generated floor), through its three shadow fights to the stairs, up to the 2F
# landing (field 23 room 3) where Teddie's scene ends and the player is free. The planner routes over the floor's cell grid (plan:on); the battle
# driver plays Cross-only (the wheel's first command is Attack), Shuffle Time included; battleskip:on keeps a walk going through the fights.
timeout:6000
walk:0,200,40
press:cross
wait:200
skipfield:40:0
timeout:12000
skipmsg
plan:on
battleskip:on
battle:first=circle,cross,cross;plan=circle,cross,cross;skip=0;delay=20
battlerule:dead=circle,down,down,down,cross,item:783,cross,cross
battlerule:hp<30=circle,down,down,down,cross,item:770,cross,cross
timeout:30000
walk:goal
press:cross
wait:600
timeout:12000
skipmsg
wait:600

# The 2F corridor's middle area (3402, z 1621..2147, script 9) starts Shadow Chie's mandatory event and fight.
# The battle: driver stays active during skipfield; battleskip:off only changes walking input.
# Victory and Chie's awakening lead through the Junes TV and dinner to the living room, free on 04/17 evening.
battleskip:off
plan:off
timeout:3000
walk:0,2500,80
push:0,1000,60
# Yu's Cleave and Yosuke's Garu (the boss's wind weakness) by skill ID, from any wheel position.
battle:first=circle,cross,cross;plan=circle,cross,cross;first1=circle,down,cross,skill:121,cross,cross;plan1=circle,down,cross,skill:121,cross,cross;first2=circle,down,cross,skill:14,cross,cross;plan2=circle,down,cross,skill:14,cross,cross
battlerule:dead=circle,down,down,down,cross,item:783,cross,cross
battlerule:hp<30=circle,down,down,down,cross,item:770,cross,cross
battlerule:sp<3@2=circle,cross,cross
timeout:20000
skipfield:7:2
skipmsg
wait:60
# The calendar (the living room's save_point area): Save, slot 1 (the loaded 04/15 file: "Overwrite?" Yes is one Left from the default No).
autoskip:off
push:103,-217,150
wait:900
press:cross               # the calendar: the memory card screen
wait:600
press:cross               # slot 1
wait:600
press:left:12             # Yes
wait:400
press:cross               # overwrite
wait:1500
press:cross               # Save successful
wait:600
log
