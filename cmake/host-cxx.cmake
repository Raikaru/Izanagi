include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/reproducible.cmake")

# Call in the root directory, before inherited game-C flags/launchers are set.
macro(p4_host_cxx_enable)
  if(NOT CMAKE_CXX_COMPILER)
    get_filename_component(_p4_cc_dir "${CMAKE_C_COMPILER}" DIRECTORY)
    get_filename_component(_p4_cc_name "${CMAKE_C_COMPILER}" NAME)
    string(REPLACE "clang" "clang++" _p4_cxx_name "${_p4_cc_name}")
    if(_p4_cxx_name STREQUAL _p4_cc_name)
      unset(_p4_cxx)
      find_program(_p4_cxx NAMES clang++ HINTS "${_p4_cc_dir}" REQUIRED)
    else()
      set(_p4_cxx "${_p4_cc_dir}/${_p4_cxx_name}")
    endif()
    # The C-only cache may retain NOTFOUND after an earlier failed discovery.
    # A valid explicit C++ compiler never enters this branch.
    set(CMAKE_CXX_COMPILER "${_p4_cxx}" CACHE FILEPATH "Paired host-adapter C++17 compiler" FORCE)
  endif()
  enable_language(CXX)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    message(FATAL_ERROR "Host C++ adapters require paired clang/clang++")
  endif()
endmacro()

# The caller supplies the existing P4 profile flags, never guesses a second
# architecture. Use in isolated subdirectories, without game forced includes
# or the guest-pointer/EE-float C launcher. Exceptions remain component-owned.
function(p4_host_cxx_target target)
  target_compile_features(${target} PUBLIC cxx_std_17)
  target_compile_options(${target} PRIVATE ${ARGN} -O2 -g1 -fno-rtti
    -ffp-contract=off -ffunction-sections -fdata-sections)
  set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
endfunction()

# Apply to the C-boundary static library; settings reach its final consumers.
# suffix is the existing profile suffix (empty, 64, or 64w); ARGN = profile flags.
function(p4_host_cxx_runtime target suffix)
  if(ANDROID AND NOT CMAKE_ANDROID_STL_TYPE STREQUAL "c++_static" AND NOT ANDROID_STL STREQUAL "c++_static")
    message(FATAL_ERROR "Host C++ Android adapters require -DANDROID_STL=c++_static")
  endif()
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Windows")
    target_link_options(${target} INTERFACE -static-libstdc++ -static-libgcc)
  endif()
  if(CMAKE_SYSTEM_NAME STREQUAL "Windows" OR suffix STREQUAL "64w")
    p4_pe_reproducible_link_flags(pe_repro_flags)
    target_link_options(${target} INTERFACE ${pe_repro_flags})
    target_link_libraries(${target} INTERFACE -Wl,-Bstatic winpthread -Wl,-Bdynamic)
  endif()
  if(APPLE)
    target_link_options(${target} INTERFACE -Wl,-dead_strip)
  else()
    target_link_options(${target} INTERFACE -Wl,--gc-sections)
  endif()
  target_link_options(${target} INTERFACE ${ARGN})
endfunction()

# Run after the existing mirror profile detection. callback(suffix, flags...)
# builds one adapter graph for each profile the root already selected.
function(p4_host_cxx_profiles callback)
  set(coff_profile FALSE)
  if(P4_PORT64_LINK AND P4_PORT64W_OBJS AND EXISTS "${P4_WIN64_PREFIX}/lib")
    set(coff_profile TRUE)
    # Match the root COFF link policy before a child directory creates links.
    # MinGW lld cannot consume ELF --dependency-file. This is a directory
    # variable, not a target property; archive/target dependencies remain.
    set(CMAKE_LINK_DEPENDS_USE_LINKER OFF PARENT_SCOPE)
  endif()
  if(NOT P4_ANDROID64 AND NOT P4_PORT64_ARCH STREQUAL "aarch64" AND NOT P4_APPLE)
    cmake_language(CALL "${callback}" "" ${P4_TARGET_FLAGS})
  endif()
  if(P4_PORT64_LINK AND P4_PORT64_OBJS)
    cmake_language(CALL "${callback}" 64 ${P4_X64_TARGET_FLAGS} ${P4_X64_EXTRA_FLAGS})
  endif()
  if(coff_profile)
    # Every executable/DLL/tool created by this profile needs the PE policy,
    # including consumers of analysis-only archives rather than the C runtime.
    get_directory_property(previous_link_options LINK_OPTIONS)
    p4_pe_reproducible_link_flags(pe_profile_flags)
    add_link_options(${pe_profile_flags})
    cmake_language(CALL "${callback}" 64w --target=x86_64-w64-mingw32 -m64)
    set_property(DIRECTORY PROPERTY LINK_OPTIONS "${previous_link_options}")
  endif()
endfunction()

# Object-library expressions do not carry usage requirements. Register each
# host boundary once; defer final links until test factories have finished
# cloning profiles, so a base fixture cannot copy a foreign-ABI adapter.
function(p4_host_adapter_register suffix language)
  if(NOT language STREQUAL "C" AND NOT language STREQUAL "CXX")
    message(FATAL_ERROR "Host adapter language must be C or CXX")
  endif()
  set(object "p4port${suffix}")
  get_property(libraries GLOBAL PROPERTY P4_HOST_ADAPTERS_${object})
  foreach(library IN LISTS ARGN)
    if(NOT TARGET ${library})
      message(FATAL_ERROR "Host adapter target does not exist: ${library}")
    endif()
    list(APPEND libraries "${library}")
  endforeach()
  list(REMOVE_DUPLICATES libraries)
  set_property(GLOBAL PROPERTY P4_HOST_ADAPTERS_${object} "${libraries}")
  set_property(GLOBAL APPEND PROPERTY P4_HOST_ADAPTER_OBJECTS "${object}")
  if(language STREQUAL "CXX")
    set_property(GLOBAL PROPERTY P4_HOST_ADAPTER_CXX_${object} TRUE)
  endif()
  get_property(scheduled GLOBAL PROPERTY P4_HOST_ADAPTERS_DEFERRED)
  if(NOT scheduled)
    set_property(GLOBAL PROPERTY P4_HOST_ADAPTERS_DEFERRED TRUE)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}"
      CALL _p4_host_adapters_attach_directory "${CMAKE_SOURCE_DIR}")
  endif()
endfunction()

# Explicit seam for a factory that does not retain its TARGET_OBJECTS source.
function(p4_host_adapter_attach target object)
  get_property(libraries GLOBAL PROPERTY P4_HOST_ADAPTERS_${object})
  if(NOT libraries)
    return()
  endif()
  get_target_property(attached ${target} P4_HOST_ADAPTER_LIBRARIES)
  set(missing)
  foreach(library IN LISTS libraries)
    if(NOT library IN_LIST attached)
      list(APPEND missing "${library}")
    endif()
  endforeach()
  if(missing)
    get_target_property(type ${target} TYPE)
    if(type STREQUAL "STATIC_LIBRARY" OR type STREQUAL "OBJECT_LIBRARY")
      target_link_libraries(${target} PRIVATE ${missing})
    else()
      # Final consumers may already use either target_link_libraries signature.
      # Append their private direct link dependencies without mixing signatures.
      set_property(TARGET ${target} APPEND PROPERTY LINK_LIBRARIES ${missing})
    endif()
    set_property(TARGET ${target} APPEND PROPERTY P4_HOST_ADAPTER_LIBRARIES ${missing})
  endif()
  get_property(cxx GLOBAL PROPERTY P4_HOST_ADAPTER_CXX_${object})
  if(cxx)
    set_property(TARGET ${target} PROPERTY LINKER_LANGUAGE CXX)
  endif()
endfunction()

function(_p4_host_adapters_attach_directory directory)
  get_property(objects GLOBAL PROPERTY P4_HOST_ADAPTER_OBJECTS)
  list(REMOVE_DUPLICATES objects)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type ${target} TYPE)
    if(NOT type STREQUAL "EXECUTABLE" AND NOT type STREQUAL "SHARED_LIBRARY" AND NOT type STREQUAL "MODULE_LIBRARY")
      continue()
    endif()
    get_target_property(sources ${target} SOURCES)
    get_target_property(links ${target} LINK_LIBRARIES)
    foreach(object IN LISTS objects)
      string(FIND "${sources};${links}" "$<TARGET_OBJECTS:${object}>" occurrence)
      if(NOT occurrence EQUAL -1 OR object IN_LIST links)
        p4_host_adapter_attach(${target} "${object}")
      endif()
    endforeach()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    _p4_host_adapters_attach_directory("${child}")
  endforeach()
endfunction()
