# Dojima living room (04/11 evening) -> stairs -> Your Room -> futon -> "Go to sleep? Yes" -> the fog dream, controllable.
# Retail: p4hook --walk FILE (from the state ng-livingroom). Port: P4PC_WALK_SCRIPT=FILE after the New Game events.
# Coordinates are world units read from the player's matrix (task `rotate pc`, work + 0x48): living room x -313..459, z -270..222.
waitcontrol:on
wait:30
walk:314,-360,25          # the foot of the stairs (the CHECK icon)
wait:20
press:cross               # go upstairs
wait:40
skipmsg                   # "This is the room you're borrowing from Dojima..."
wait:30
press:down:200            # to the wall by the futon (Your Room: x -16..240, z -184..133)
wait:30
press:cross               # CHECK the futon: "The futon has been prepared", Help, "Go to sleep?" (Yes is the default)
wait:40
skipmsg                   # Cross through the prompts, the sleep, up to the first control in the dream
